# Pin an exact stable version from https://docs.n8n.io/hosting/installation/docker/ (never "latest")
N8N_VERSION=

# Generate with: openssl rand -hex 32
# Never change it once n8n has stored credentials, or they become unreadable.
N8N_ENCRYPTION_KEY=

# Only read by the "eval" service (scripts/run_eval.py). n8n keeps its own copy in its encrypted credentials.
OPENAI_API_KEY=
